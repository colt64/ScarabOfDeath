			"y":2120,
			"width":1020,
			"height":620
		},
		{
			"id":"eae304d4c06b49c7",
			"type":"text",
			"text":"# [[The Cover Up]]\n\nThe party may wish to try to cover up [[Aaron Littlehorn]]'s death, hiding it from his father [[Lord Archibald Littlehorn]], to gain extra time to investigate.\n\nSee the [[The Cover Up|note]] for ways they may accomplish this\n",
			"dynamicHeight":true,
			"styleAttributes":{},
			"x":-820,
			"y":300,
			"width":320,
			"height":240,
			"color":"1"
		},
		{"id":"4f8ad48fbb628bd5","type":"text","text":"# [[Running the Adventure]]\n\n> [!NOTE]- Getting The PCs Involved\n> ![[Running the Adventure#Getting the PCs Involved]]\n\n> [!tip]- Roleplaying\n> ![[Running the Adventure#Roleplaying]] \n\n> [!warning]- Monster Statistics\n> ![[Running the Adventure#Monster Statistics]]","x":-240,"y":-920,"width":420,"height":520},
		{
			"id":"474c1efea7620eab",
