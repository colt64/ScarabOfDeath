		},
		{
			"id":"f3063162a0064c3c",
			"type":"text",
			"text":"# [[Nabulee’s Bazaar of the Extraordinary Vault Room map]]\n![[Nabulee’s Bazaar of the Extraordinary Vault Room map#Map]]",
			"dynamicHeight":true,
			"styleAttributes":{},
