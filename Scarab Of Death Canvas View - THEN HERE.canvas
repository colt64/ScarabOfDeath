		{"id":"4d9c0a2617bce8ab","type":"file","file":"_Attachments/pdfcoffee.com_scarab-of-death-5e-10lvl-pdf-free.pdf","dynamicHeight":true,"x":-1800,"y":-280,"width":800,"height":1000},
		{
			"id":"ada54b23de0e1054",
			"type":"text",
			"text":"# [[General Campaign Reminders]]\n\n> [!important]- Divination Magic\n> ![[General Campaign Reminders#Divination Magic|Divination Magic]]\n\n> [!NOTE]- Helping Your Players\n> [[General Campaign Reminders#Helping your Players|Helping your Players]]\n\n> [!success]- Restoring Nabulee's Memory\n> ![[General Campaign Reminders#Restoring Nabulee’s Memory|Restoring Nabulee’s Memory]]\n\n> [!warning]- The Cost of Failure\n> ![[General Campaign Reminders#The Cost of Failure|The Cost of Failure]]\n",
			"dynamicHeight":true,
			"styleAttributes":{},
			"x":-820,
			"y":-920,
			"width":560,
